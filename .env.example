# Copie para .env.local (desenvolvimento) e preencha. Nunca commite .env.local.
# Na Vercel, cadastre as mesmas variáveis em Project Settings -> Environment Variables.

# --- Front-end (build) ---
# Base da API. Deixe vazio para o modo demo (cardápio em localStorage, sem banco).
VITE_API_BASE_URL="/api"
# Módulos ainda desligados nesta versão; "true" só quando o backend deles existir.
# VITE_FEATURE_PEDIDOS="false"
# VITE_FEATURE_CAIXA="false"
# VITE_FEATURE_ENTREGAS="false"
# VITE_FEATURE_GESTORES="false"

# --- API (server/, só no servidor) ---
# Connection string POOLED do Neon (Console -> Connect -> "Connection pooling").
DATABASE_URL="postgresql://usuario:senha@ep-xxxx-pooler.us-east-1.aws.neon.tech/nossobistro?sslmode=verify-full&channel_binding=require"
# Segredo dos tokens de login: gere com `openssl rand -base64 48` (mínimo 32 caracteres).
SESSION_SECRET=""

# Neon Object Storage (fotos dos produtos). Console -> Connect -> Storage.
# Prefixo NEON_STORAGE_ porque a Vercel reserva os nomes AWS_*.
NEON_STORAGE_ENDPOINT="https://br-xxxx.storage.c-13.us-east-1.aws.neon.tech"
NEON_STORAGE_REGION="us-east-1"
NEON_STORAGE_BUCKET="produtos"
NEON_STORAGE_ACCESS_KEY_ID="nak_live_..."
NEON_STORAGE_SECRET_ACCESS_KEY="nsk_live_..."

# --- Só para os scripts db:seed / admin:password (NÃO cadastrar na Vercel) ---
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
