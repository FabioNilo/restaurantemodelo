# n8n webhook backend.
VITE_CHIPTRACK_WEBHOOK_BASE_URL="https://your-n8n-host/webhook"
VITE_CHIPTRACK_WEBHOOK_KEY="your-webhook-key"
CHIPTRACK_SESSION_SECRET="your-session-secret"

# API flags: this clone is n8n/PostgreSQL only.
VITE_MARMITAS_PUBLIC_API="n8n"
VITE_MARMITAS_AUTH_API="n8n"
VITE_MARMITAS_ADMIN_API="n8n"

# External PostgreSQL used by database scripts and n8n credentials.
MASSAS_DATABASE_URL="postgres://user:password@host:5432/database"

# Admin credential rotation. Do not commit real values.
ADMIN_USERNAME="admin@example.com"
ADMIN_PASSWORD=""
ADMIN_PASSWORD_HASH=""
ADMIN_FULL_NAME="Administrador"
ADMIN_ROLE_SLUG="admin"
MASSAS_DATABASE_SCHEMA="marmita_fit"
MASSAS_DATABASE_SSL="true"
